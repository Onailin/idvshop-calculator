# Database (Neon PostgreSQL)
DATABASE_URL="postgresql://user:password@host/database?sslmode=require"

# Auth.js (required on Vercel — without AUTH_SECRET login returns 500)
AUTH_SECRET="generate-with: openssl rand -base64 32"
AUTH_URL="http://localhost:3000"

# AWS S3 (images stored in S3; PostgreSQL stores URLs only)
AWS_ACCESS_KEY_ID="your-access-key"
AWS_SECRET_ACCESS_KEY="your-secret-key"
AWS_REGION="ap-southeast-2"
AWS_S3_BUCKET_NAME="your-bucket-name"
# Optional legacy alias (AWS_S3_BUCKET_NAME takes precedence)
# AWS_S3_BUCKET="your-bucket-name"
# Optional: CloudFront or custom public base URL for uploaded images
# Must match the bucket's actual region (check in AWS S3 console)
AWS_S3_PUBLIC_URL="https://your-bucket-name.s3.ap-southeast-2.amazonaws.com"
# Use direct S3 URLs when bucket allows public read (requires bucket policy)
AWS_S3_PUBLIC_READ="false"
NEXT_PUBLIC_AWS_S3_PUBLIC_READ="false"
NEXT_PUBLIC_AWS_S3_PUBLIC_URL="https://your-bucket-name.s3.ap-southeast-2.amazonaws.com"
# Development only: set to true if upload fails with SSL certificate errors on Windows
AWS_S3_TLS_INSECURE="false"

# Optional: rate limiting
RATE_LIMIT_MAX_REQUESTS="10"
RATE_LIMIT_WINDOW_MS="60000"

# Database seed (required in production when running npm run db:seed)
# SEED_ADMIN_PASSWORD="use-a-strong-password-here"
# Set to true only when you intentionally want seed to overwrite existing admin passwords
# SEED_FORCE_PASSWORD="false"
