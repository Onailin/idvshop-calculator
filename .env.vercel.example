# Vercel production values (copy into Vercel → Settings → Environment Variables)
# ⚠️ ไฟล์ .env ในเครื่องไม่ถูก push ขึ้น Git — ต้องใส่บน Vercel แยกต่างหาก

DATABASE_URL="postgresql://USER:PASSWORD@ep-xxx.c-2.ap-southeast-1.aws.neon.tech/neondb?sslmode=require"

AUTH_SECRET="paste-output-from: openssl rand -base64 32"
AUTH_URL="https://idvshop-calculator-r2dg.vercel.app"

AWS_ACCESS_KEY_ID="your-access-key"
AWS_SECRET_ACCESS_KEY="your-secret-key"
AWS_REGION="ap-southeast-2"
AWS_S3_BUCKET="idvcal-images"
AWS_S3_PUBLIC_URL="https://idvcal-images.s3.ap-southeast-2.amazonaws.com"
AWS_S3_PUBLIC_READ="true"
NEXT_PUBLIC_AWS_S3_PUBLIC_READ="true"
NEXT_PUBLIC_AWS_S3_PUBLIC_URL="https://idvcal-images.s3.ap-southeast-2.amazonaws.com"
AWS_S3_TLS_INSECURE="false"
